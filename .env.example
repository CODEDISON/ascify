# Ascify build
# LLVM_BUILD_DIR may be a development installation or a build tree.
LLVM_BUILD_DIR=/path/to/llvm
# Optional checkout shorthand when LLVM_BUILD_DIR is not set:
# LLVM_PROJECT_PATH=/path/to/llvm-project
ASCIFY_CC=/path/to/llvm/bin/clang
ASCIFY_CXX=/path/to/llvm/bin/clang++
# Optional; omit to let the compiler select the system linker.
ASCIFY_LINKER=/path/to/linker

# CUDA parsing on the conversion host
CUDA_PATH=/path/to/user-owned/cuda
# Optional override; match the major version of the selected Clang.
# Installed binaries discover these private parsing resources automatically.
CLANG_RESOURCE_DIRECTORY=/path/to/ascify_install/libexec/ascify/clang/23

# Ascend compilation on the test host
CANN_ROOT=/path/to/user-owned/cann

# Optional SSH aliases used by the documented two-host replay
ASCIFY_CONVERT_HOST=convert-host
ASCIFY_TEST_HOST=test-host
